 pub mod region;
 pub mod writer;
 pub mod xml;
+
+/// Directory for temporary files.
+///
+/// Several readers stage bytes through a temporary file because they must hand
+/// a path to another reader: OIB embeds whole TIFF streams, and `TiffReader`
+/// only accepts a path. `std::env::temp_dir()` panics outright on wasm ("no
+/// filesystem on wasm"), so there this returns `/tmp`, which the host is
+/// expected to mount as a writable directory.
+pub fn temp_dir() -> std::path::PathBuf {
+    if cfg!(target_family = "wasm") {
+        std::path::PathBuf::from("/tmp")
+    } else {
+        // Unreachable on wasm, so the panicking call is compiled but never run.
+        std::env::temp_dir()
+    }
+}
+
+/// A value unique to this process, used only to name temporary files.
+///
+/// `std::process::id()` panics on wasm, where there are no processes. A counter
+/// gives the same uniqueness guarantee within one module instance, which is all
+/// these call sites need.
+pub fn process_id() -> u32 {
+    if cfg!(target_family = "wasm") {
+        use std::sync::atomic::{AtomicU32, Ordering};
+        static NEXT: AtomicU32 = AtomicU32::new(1);
+        NEXT.fetch_add(1, Ordering::Relaxed)
+    } else {
+        std::process::id()
+    }
+}
