+    /// The scanner's fill colour, which is what an unscanned margin shows.
+    ///
+    /// Brightfield slides are lit through the glass, so white is the right
+    /// assumption when a format declares nothing.
+    fn background_rgb(slide: &OpenSlide) -> [u8; 3] {
+        const WHITE: [u8; 3] = [255, 255, 255];
+        let Some(hex) = slide.property_value(properties::PROPERTY_BACKGROUND_COLOR) else {
+            return WHITE;
+        };
+        let hex = hex.trim();
+        if hex.len() != 6 || !hex.is_ascii() {
+            return WHITE;
+        }
+        match (
+            u8::from_str_radix(&hex[0..2], 16),
+            u8::from_str_radix(&hex[2..4], 16),
+            u8::from_str_radix(&hex[4..6], 16),
+        ) {
+            (Ok(r), Ok(g), Ok(b)) => [r, g, b],
+            _ => WHITE,
+        }
+    }
